            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/log/publicKey",
            "params": [
              {
                "name": "treeID",
                "value": "",
                "type": "query",
                "description": "The tree ID of the tree you wish to get a public key for"
              }
            ]
          },
          "docs": "Returns the public key that can be used to validate the signed tree head"
        }
      ]
    }
  ],
  "bundled": true
